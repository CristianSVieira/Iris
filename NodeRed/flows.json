        "type": "function",
        "z": "4bd8fa85fb287fc9",
        "name": "function 3",
        "func": "msg.topic = `\n    insert into product\n    (\n        product_category,\n        product_title,\n        product_description,\n        product_price,\n        product_inventory\n    )\n    values\n    (\n        '${msg.payload.product_category}', \n        '${msg.payload.product_title}', \n        '${msg.payload.product_description}', \n        ${msg.payload.product_price},\n        ${msg.payload.product_inventory}\n    )\n    ;\n`;\n\nreturn msg;",
