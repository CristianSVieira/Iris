    {
        "id": "d0741adef5560170",
        "type": "function",
        "z": "4bd8fa85fb287fc9",
        "name": "function 1",
        "func": "msg.topic = `\n    drop database if exists iris_;\n    \n    create database iris_;\n    use iris_;\n\n    create table product(\n        product_id int not null primary key auto_increment,\n        product_category tinytext not null,\n        product_title tinytext not null,\n        product_description text not null,\n        product_price decimal(19,4) null,\n        product_inventory int null\n    );\n`;\n\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
