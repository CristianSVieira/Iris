    {
        "id": "63e7442cbde0be49",
        "type": "function",
        "z": "4bd8fa85fb287fc9",
        "name": "function 7",
        "func": "    let _html = `\n    <table class='table'>\n        <tr>\n            <th>ID</th>\n            <th>Categoria</th>\n            <th>Título</th>\n            <th>Descrição</th>\n            <th>Preço</th>\n            <th>Inventário</th>\n        </tr>\n    `;\n        \n    for (let index = 0; index < msg.payload.length; ++index) {\n        let data = msg.payload[index];\n        console.log(data);\n        _html += \"<tr>\"\n        _html += \n        `\n        <td>${data.product_id}</td>\n        <td>${data.product_category}</td>\n        <td>${data.product_title}</td>\n        <td>${data.product_description}</td>\n        <td>${data.product_price}</td>\n        <td>${data.product_inventory}</td>\n        `\n        _html += \"</tr>\"\n    }\n\n    _html += \"</table>\";\n\n    msg.payload = _html;\n    \nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
